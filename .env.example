# =========================================================
# Django
# =========================================================

# Cada instalación debe generar su propia clave.
DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_PRIVADA

# True solamente durante desarrollo.
DJANGO_DEBUG=True

# Separar varios hosts mediante comas.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Para producción o previews HTTPS, separar mediante comas.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Mantener abierto solamente durante desarrollo.
CORS_ALLOW_ALL_ORIGINS=True

# Cuando CORS_ALLOW_ALL_ORIGINS=False, colocar orígenes aquí.
CORS_ALLOWED_ORIGINS=


# =========================================================
# PostgreSQL
# =========================================================

POSTGRES_DB=resident
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432