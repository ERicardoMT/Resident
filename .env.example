# =========================================================
# Django
# =========================================================

# Cada instalación debe generar su propia clave (50 caracteres):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_PRIVADA

# False siempre que el sitio esté abierto por el túnel o en internet.
# True solo para depurar en la computadora local.
DJANGO_DEBUG=False

# Separar varios hosts mediante comas. ".devtunnels.ms" permite el túnel.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.devtunnels.ms

# Con DEBUG=False: redirigir http -> https (solo con dominio propio, no con el túnel).
DJANGO_SECURE_SSL_REDIRECT=False

# Segundos de HSTS con DEBUG=False (subir a 31536000 con dominio definitivo).
DJANGO_HSTS_SECONDS=3600

# Django sirve las fotos y modelos subidos (media/). False si hay Nginx.
DJANGO_SERVE_MEDIA=True

# Para producción o previews HTTPS, separar mediante comas.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Mantener abierto solamente durante desarrollo.
CORS_ALLOW_ALL_ORIGINS=True

# Cuando CORS_ALLOW_ALL_ORIGINS=False, colocar orígenes aquí.
CORS_ALLOWED_ORIGINS=


# =========================================================
# PostgreSQL
# =========================================================

POSTGRES_DB=resident
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432